<% layout('./layout/boilerplate') -%>

    <div class="listing-show-page">

        <div class="listing-show-container">

            <!-- Back Link -->
            <a href="/listings" class="back-link">
                ← Back to Listings
            </a>

            <!-- Main Listing Card -->
            <div class="listing-show-card">

                <!-- Image Section -->
                <div class="listing-show-image-wrapper">

                    <img src="<%= e.image?.url || 'https://via.placeholder.com/900x600' %>" alt="<%= e.title %>"
                        class="listing-show-image" />

                    <% if (e.image?.filename) { %>
                        <span class="listing-image-badge">
                            <%= e.image.filename %>
                        </span>
                        <% } %>

                </div>

                <!-- Details Section -->
                <div class="listing-show-content">

                    <!-- Location -->
                    <p class="listing-location">
                        <%= e.location %>, <%= e.country %>
                    </p>

                    <!-- Title -->
                    <h1 class="listing-show-title">
                        <%= e.title %>
                    </h1>

                    <!-- Description -->
                    <div class="listing-description-section">
                        <h2>About this place</h2>
                        <p class="listing-show-description">
                            <%= e.description %>
                        </p>
                    </div>

                    <!-- Price -->
                    <div class="listing-price-box">
                        <div>
                            <span class="price-label">Price</span>
                            <div class="listing-show-price">
                                &#8377;
                                <%= e.price ? e.price.toLocaleString("en-IN") : 'N/A' %>
                                    <span>/ night</span>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="listing-actions">
                        <a href="/listings/<%= e._id %>/edit" class="btn btn-edit">
                            Edit Listing
                        </a>

                        <form action="/listings/<%= e._id %>?_method=DELETE" method="POST">
                            <button type="submit" class="btn btn-delete">
                                Delete Listing
                            </button>
                        </form>
                    </div>

                    <!-- ================= REVIEW SECTION ================= -->
                    <div class="listing-review-section mt-5 pt-4 border-top">

                        <h2 class="mb-4">Leave a Review</h2>

                        <form action="/listings/<%= e._id %>/reviews" method="POST" class="needs-validation" novalidate>

                            <!-- Rating Field -->
                            <div class="mb-3">
                                <label for="rating" class="form-label fw-bold">Rating</label>
                                <input type="range" class="form-range" min="1" max="5" value="3" id="rating"
                                    name="review[rating]">
                            </div>

                            <!-- Date Field -->
                            <div class="mb-3">
                                <label for="date" class="form-label fw-bold">Date of Visit</label>
                                <input type="date" class="form-control" id="date" name="review[createdAt]" required>
                                <div class="invalid-feedback">Please select a date.</div>
                            </div>

                            <!-- Comment Field -->
                            <div class="mb-3">
                                <label for="comment" class="form-label fw-bold">Comment</label>
                                <textarea class="form-control" id="comment" name="review[comment]" rows="4"
                                    placeholder="Write your experience..." required></textarea>
                                <div class="invalid-feedback">Please add some comments for your review.</div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-edit mt-2">Submit Review</button>
                        </form>

                        <!-- Display Existing Reviews -->
                        <% if (e.reviews && e.reviews.length> 0) { %>
                            <div class="mt-5 pt-4 border-top">
                                <h3 class="mb-4">All Reviews (<%= e.reviews.length %>)</h3>

                                <div class="row g-3">
                                    <% for (let review of e.reviews) { %>
                                        <div class="col-12 col-md-6">
                                            <div class="card h-100 border-0 shadow-sm bg-light">
                                                <div class="card-body d-flex flex-column justify-content-between p-3">
                                                    <div>
                                                        <div
                                                            class="d-flex justify-content-between align-items-center mb-2">
                                                            <span class="badge bg-dark text-wrap">
                                                                <%= review.rating %> / 5 ⭐
                                                            </span>

                                                            <% if (review.createdAt) { %>
                                                                <small class="text-muted">
                                                                    <%= new
                                                                        Date(review.createdAt).toLocaleDateString("en-IN",
                                                                        { day: 'numeric' , month: 'short' ,
                                                                        year: 'numeric' }) %>
                                                                </small>
                                                                <% } %>
                                                        </div>

                                                        <p class="card-text text-dark mt-2 mb-3">
                                                            <%= review.comment %>
                                                        </p>
                                                    </div>

                                                    <!-- Delete Review Action -->
                                                    <form class="mt-2 align-self-end" method="POST"
                                                        action="/listings/<%= e._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                        <button class="btn btn-sm btn-delete">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>
                            </div>
                            <% } %>

                    </div>

                </div>

            </div>

        </div>

    </div>