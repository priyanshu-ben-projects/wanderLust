<% layout('./layout/boilerplate') -%>

    <form action="/listings/create" method="post" class="container my-5">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">

                <h2 class="mb-4 fw-bold">Create New Listing</h2>

                <!-- Listing Title -->
                <div class="mb-3">
                    <label for="title" class="form-label fw-semibold">
                        Listing Title
                    </label>

                    <input type="text" id="title" name="listing[title]" value="Cozy Mountain Villa"
                        placeholder="e.g., Cozy Beachside Cabin" class="form-control" required>
                </div>


                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea id="description" name="listing[description]" rows="5"
                        placeholder="Describe your listing details..." class="form-control"
                        required>A beautiful wooden villa offering spectacular mountain views, a personal bonfire area, and fully loaded modern amenities.</textarea>
                </div>


                <!-- Image URL -->
                <div class="mb-3">
                    <label for="image" class="form-label fw-semibold">
                        Image URL
                    </label>

                    <input type="url" id="image" name="listing[image]" value="https://unsplash.com"
                        placeholder="https://example.com/image.jpg" class="form-control">
                </div>


                <!-- Price -->
                <div class="mb-3">
                    <label for="price" class="form-label fw-semibold">
                        Price (USD)
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">$</span>

                        <input type="number" id="price" name="listing[price]" min="0" step="0.01" value="150.00"
                            placeholder="0.00" class="form-control" required>
                    </div>
                </div>


                <!-- Location & Country -->
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label for="location" class="form-label fw-semibold">
                            City / Location
                        </label>

                        <input type="text" id="location" name="listing[location]" value="Aspen"
                            placeholder="e.g., Los Angeles" class="form-control" required>
                    </div>


                    <div class="col-md-6 mb-3">
                        <label for="country" class="form-label fw-semibold">
                            Country
                        </label>

                        <input type="text" id="country" name="listing[country]" value="United States"
                            placeholder="e.g., United States" class="form-control" required>
                    </div>

                </div>


                <!-- Rating -->
                <div class="mb-4">
                    <label for="rating" class="form-label fw-semibold">
                        Rating (1-5)
                    </label>

                    <input type="number" id="rating" name="listing[rating]" min="1" max="5" step="0.1" value="4.9"
                        placeholder="5" class="form-control">
                </div>


                <!-- Submit -->
                <button type="submit" class="btn btn-dark px-4">
                    Create Listing
                </button>

            </div>
        </div>

    </form>