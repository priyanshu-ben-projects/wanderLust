<% layout('./layout/boilerplate') -%>

    <form action="/listings/<%= e._id %>?_method=PUT" method="post" class="container my-5">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4 p-md-5">

                <!-- Header -->
                <div class="mb-4">
                    <h2 class="fw-bold mb-1">Edit Listing</h2>

                    <p class="text-muted mb-0">
                        Update the details of your listing below.
                    </p>
                </div>


                <!-- Listing Title -->
                <div class="mb-3">

                    <label for="title" class="form-label fw-semibold">
                        Listing Title
                    </label>

                    <input type="text" id="title" name="listing[title]" value="<%= e.title %>"
                        placeholder="e.g., Cozy Beachside Cabin" class="form-control" required>

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label for="description" class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea id="description" name="listing[description]" rows="5"
                        placeholder="Describe your listing details..." class="form-control"
                        required><%= e.description %></textarea>

                </div>


                <!-- Image URL -->
                <div class="mb-3">

                    <label for="imageUrl" class="form-label fw-semibold">
                        Image URL
                    </label>

                    <input type="url" id="imageUrl" name="listing[image][url]" value="<%= e.image?.url || '' %>"
                        placeholder="https://example.com/image.jpg" class="form-control">

                </div>


                <!-- Image Filename -->
                <div class="mb-3">

                    <label for="imageFilename" class="form-label fw-semibold">
                        Image Filename
                    </label>

                    <input type="text" id="imageFilename" name="listing[image][filename]"
                        value="<%= e.image?.filename || '' %>" placeholder="e.g., mountain-villa.jpg"
                        class="form-control">

                </div>


                <!-- Price -->
                <div class="mb-3">

                    <label for="price" class="form-label fw-semibold">
                        Price (₹ / night)
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            &#8377;
                        </span>

                        <input type="number" id="price" name="listing[price]" min="0" step="1"
                            value="<%= e.price || '' %>" placeholder="0" class="form-control" required>

                    </div>

                </div>


                <!-- Location & Country -->
                <div class="row">

                    <!-- Location -->
                    <div class="col-md-6 mb-3">

                        <label for="location" class="form-label fw-semibold">
                            City / Location
                        </label>

                        <input type="text" id="location" name="listing[location]" value="<%= e.location %>"
                            placeholder="e.g., Manali" class="form-control" required>

                    </div>


                    <!-- Country -->
                    <div class="col-md-6 mb-3">

                        <label for="country" class="form-label fw-semibold">
                            Country
                        </label>

                        <input type="text" id="country" name="listing[country]" value="<%= e.country %>"
                            placeholder="e.g., India" class="form-control" required>

                    </div>

                </div>


                <!-- Rating -->
                <div class="mb-4">

                    <label for="rating" class="form-label fw-semibold">
                        Rating (1-5)
                    </label>

                    <input type="number" id="rating" name="listing[rating]" min="1" max="5" step="0.1"
                        value="<%= e.rating || '' %>" placeholder="5" class="form-control">

                </div>


                <!-- Actions -->
                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-dark px-4">
                        Update Listing
                    </button>

                    <a href="/listings/<%= e._id %>" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                </div>

            </div>

        </div>

    </form>