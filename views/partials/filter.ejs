<style>
    .category-bar {
        z-index: 1020;
    }

    .category-list {
        gap: 1.5rem;
        overflow-x: auto;
        scroll-snap-type: x proximity;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .category-list::-webkit-scrollbar {
        display: none;
    }

    .category-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .35rem;
        padding: .75rem .25rem;
        min-width: 64px;
        background: none;
        border: 0;
