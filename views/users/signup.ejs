<% layout('./layout/boilerplate') -%>

    <div class="wl-auth-page">
        <div class="wl-auth-container">

            <!-- Signup Card -->
            <div class="wl-auth-card">

                <!-- Header -->
                <div class="wl-auth-header">
                    <div class="wl-auth-icon">
                        <i class="bi bi-compass"></i>
                    </div>

                    <span class="wl-auth-eyebrow">Start your journey</span>

                    <h1>Create an Account</h1>

                    <p>
                        Join WanderLust and start discovering places worth remembering.
                    </p>
                </div>

                <!-- Form -->
                <form action="/signup" method="POST" class="wl-auth-form needs-validation" novalidate>

                    <!-- Username -->
                    <div class="wl-auth-field">
                        <label for="username">Username</label>

                        <div class="wl-input-wrapper">
                            <i class="bi bi-person wl-input-icon"></i>

                            <input type="text" class="wl-auth-input" id="username" name="username"
                                placeholder="Choose a username" autocomplete="username" required>
                        </div>

                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">
                            Please enter a valid username.
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="wl-auth-field">
                        <label for="email">Email Address</label>

                        <div class="wl-input-wrapper">
                            <i class="bi bi-envelope wl-input-icon"></i>

                            <input type="email" class="wl-auth-input" id="email" name="email"
                                placeholder="name@example.com" autocomplete="email" required>
                        </div>

                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">
                            Please enter a valid email address.
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="wl-auth-field">
                        <label for="password">Password</label>

                        <div class="wl-input-wrapper">
                            <i class="bi bi-lock wl-input-icon"></i>

                            <input type="password" class="wl-auth-input" id="password" name="password"
                                placeholder="Create a password" autocomplete="new-password" required>

                            <button type="button" class="wl-password-toggle" onclick="toggleSignupPassword()"
                                aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">
                            Please enter a password.
                        </div>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="wl-auth-submit">
                        <span>Create Account</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </form>

                <!-- Divider -->
                <div class="wl-auth-divider">
                    <span>or</span>
                </div>

                <!-- Login -->
                <p class="wl-auth-footer">
                    Already have an account?
                    <a href="/login">Log in</a>
                </p>

            </div>

            <!-- Trust -->
            <div class="wl-auth-trust">
                <i class="bi bi-shield-check"></i>
                <span>Your account information is kept secure.</span>
            </div>

        </div>
    </div>

    <script>
        function toggleSignupPassword() {
            const password = document.getElementById("password");
            const icon = document.querySelector(".wl-password-toggle i");

            if (password.type === "password") {
                password.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                password.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>