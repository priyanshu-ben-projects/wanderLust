<% layout("/layout/boilerplate") -%>

    <div class="wl-auth-page">
        <div class="wl-auth-container">

            <!-- Login Card -->
            <div class="wl-auth-card">

                <!-- Header -->
                <div class="wl-auth-header">
                    <div class="wl-auth-icon">
                        <i class="bi bi-compass"></i>
                    </div>

                    <span class="wl-auth-eyebrow">Welcome back</span>
                    <h1>Login to WanderLust</h1>
                    <p>Continue your journey and discover your next stay.</p>
                </div>

                <!-- Form -->
                <form action="/login" method="POST" class="wl-auth-form needs-validation" novalidate>

                    <!-- Username -->
                    <div class="wl-auth-field">
                        <label for="username">Username</label>

                        <div class="wl-input-wrapper">
                            <i class="bi bi-person wl-input-icon"></i>

                            <input type="text" class="wl-auth-input" id="username" name="username"
                                placeholder="Enter your username" autocomplete="username" required>
                        </div>

                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter your username.</div>
                    </div>

                    <!-- Password -->
                    <div class="wl-auth-field">
                        <label for="password">Password</label>

                        <div class="wl-input-wrapper">
                            <i class="bi bi-lock wl-input-icon"></i>

                            <input type="password" class="wl-auth-input" id="password" name="password"
                                placeholder="Enter your password" autocomplete="current-password" required>

                            <button type="button" class="wl-password-toggle" onclick="togglePassword()"
                                aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter your password.</div>
                    </div>

                    <!-- Options -->
                    <div class="wl-auth-options">
                        <label class="wl-remember">
                            <input type="checkbox" id="rememberMe">
                            <span>Remember me</span>
                        </label>

                        <a href="/forgot-password">Forgot password?</a>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="wl-auth-submit">
                        <span>Log In</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </form>

                <!-- Divider -->
                <div class="wl-auth-divider">
                    <span>or</span>
                </div>

                <!-- Signup -->
                <p class="wl-auth-footer">
                    Don't have an account?
                    <a href="/signup">Create an account</a>
                </p>

            </div>

            <!-- Bottom Message -->
            <div class="wl-auth-trust">
                <i class="bi bi-shield-check"></i>
                <span>Your account information is kept secure.</span>
            </div>

        </div>
    </div>

    <script>
        function togglePassword() {
            const password = document.getElementById("password");
            const icon = document.querySelector(".wl-password-toggle i");

            if (password.type === "password") {
                password.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                password.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>